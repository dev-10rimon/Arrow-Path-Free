<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="style.uss" />
    
    <ui:VisualElement class="root">
        <!-- ব্যাকগ্রাউন্ড -->
        <ui:VisualElement class="background" picking-mode="Ignore" />

        <!-- গেমপ্লে লেয়ার (ফল এবং এফেক্ট স্পন হবে) -->
        <ui:VisualElement name="game-area" class="game-area" picking-mode="Ignore" />

        <!-- উপরের আধুনিক HUD -->
        <ui:VisualElement class="top-hud" picking-mode="Ignore">
            <!-- বাম পাশ: লাইফ/হার্ট -->
            <ui:VisualElement class="hud-left" picking-mode="Ignore">
                <ui:Label text="LIVES" class="label-tiny" />
                <ui:Label name="lives-label" text="❤️❤️❤️❤️❤️" class="hud-label" />
            </ui:VisualElement>

            <!-- মাঝখান: স্কোর -->
            <ui:VisualElement class="hud-center" picking-mode="Ignore">
                <ui:Label text="SCORE" class="label-tiny" />
                <ui:Label name="score-label" text="0" class="score-text" />
            </ui:VisualElement>

            <!-- ডান পাশ: মোড ও সেটিংস -->
            <ui:VisualElement class="hud-right" picking-mode="Ignore">
                <ui:Button name="btn-mode-toggle" text="⚙️" class="hud-btn" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- স্টার্ট স্ক্রিন প্যানেল -->
        <ui:VisualElement name="start-screen" class="panel">
            <ui:Label text="FRUIT SLASHER" class="overlay-title glow-text" />
            <ui:Label text="SLICES &amp; JUICE ARCADE" class="hud-subtext" style="margin-bottom: 30px;" />

            <ui:Button name="btn-start-easy" text="PLAY EASY" class="menu-btn play-btn" />
            <ui:Button name="btn-start-zen" text="ZEN MODE (NO BOMBS)" class="menu-btn" />
        </ui:VisualElement>

        <!-- গেম ওভার স্ক্রিন প্যানেল -->
        <ui:VisualElement name="gameover-screen" class="panel hidden">
            <ui:Label text="GAME OVER" class="overlay-title game-over" />

            <!-- স্ট্যাটস কার্ড -->
            <ui:VisualElement class="stats-container">
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Final Score" class="stat-label" />
                    <ui:Label name="go-score-val" text="0" class="stat-value accent" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Fruits Sliced" class="stat-label" />
                    <ui:Label name="go-sliced-val" text="0" class="stat-value success" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-row">
                    <ui:Label text="Best Score" class="stat-label" />
                    <ui:Label name="go-best-val" text="0" class="stat-value" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="btn-retry" text="PLAY AGAIN" class="menu-btn play-btn" />
            <ui:Button name="btn-gameover-zen" text="ZEN MODE" class="menu-btn" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>