<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <Style src="style.uss" />
  <ui:VisualElement name="root" class="root">
    <ui:VisualElement name="playfield" class="playfield" picking-mode="Ignore" />
    <ui:VisualElement name="input-catcher" class="input-catcher" picking-mode="Position" />

    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
      <ui:VisualElement class="hud-row">
        <ui:VisualElement class="panel">
          <ui:Label text="স্কোর" class="cap" />
          <ui:Label name="score-value" text="0" class="big-amber" />
          <ui:Label text="সেরা" class="cap" />
          <ui:Label name="best-value" text="0" class="big-green" />
        </ui:VisualElement>
        <ui:VisualElement class="hud-row-right">
          <ui:VisualElement name="lives-container" class="panel lives" />
          <ui:Button name="btn-mode" class="pill green" text="🌿 সহজ মোড" />
          <ui:Button name="btn-sound" class="pill" text="🔊" />
          <ui:Button name="btn-restart" class="pill amber" text="রিস্টার্ট" />
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="start-modal" class="modal-wrap">
      <ui:VisualElement class="modal">
        <ui:Label text="FRUIT SLASHER" class="title" />
        <ui:Label text="ফলগুলো বড় ও ধীরে উড়বে। ছোঁয়ালেই কাটা যাবে!" class="desc" />
        <ui:VisualElement class="mode-grid">
          <ui:Button name="btn-easy-sel" text="🌿 সহজ মোড" class="mode-btn" />
          <ui:Button name="btn-zen-sel"  text="🧘 জেন মোড" class="mode-btn" />
        </ui:VisualElement>
        <ui:Button name="btn-play" text="খেলা শুরু করুন 🍉" class="primary" />
      </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="gameover-modal" class="modal-wrap" style="display:none">
      <ui:VisualElement class="modal">
        <ui:Label name="gameover-badge" text="🌟 দারুণ খেলেছেন!" class="cap" />
        <ui:Label text="খেলা সমাপ্ত" class="title" />
        <ui:Label name="final-score" text="0" class="big-amber" />
        <ui:Label name="best-score" text="0" class="big-green" />
        <ui:Button name="btn-again" text="আবার খেলুন 🔄" class="primary" />
        <ui:Button name="btn-zen-over" text="🧘 রিল্যাক্স মোডে খেলুন" class="pill" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
</ui:UXML>