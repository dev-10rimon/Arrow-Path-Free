<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="GameStyles.uss" />
    <ui:VisualElement name="main-container" class="main-container" picking-mode="Ignore">
        
        <ui:VisualElement class="top-bar" picking-mode="Ignore">
            <ui:Label text="Ball Sort Puzzle" class="title" />
            <ui:Button name="reset-button" text="Reset" class="btn-reset" />
        </ui:VisualElement>

        <ui:VisualElement name="tubes-container" class="tubes-container" picking-mode="Ignore">
            <!-- টিউবগুলো C# দিয়ে তৈরি হবে -->
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>