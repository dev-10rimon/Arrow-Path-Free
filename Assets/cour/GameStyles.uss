.main-container {
    flex-grow: 1;
    background-color: #1a1a2e;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 10px;
}

.top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 95%;
    height: 10%;
    margin-bottom: 20px;
}

.title {
    color: white;
    font-size: 28px;
    -unity-font-style: bold;
}

.btn-reset {
    background-color: #e94560;
    color: white;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 18px;
    border-width: 0;
}

.tubes-container {
    flex-direction: row;
    justify-content: space-around;
    align-items: flex-end;
    width: 100%;
    height: 75%;
}

.tube {
    width: 13%;
    height: 100%;
    max-width: 75px;
    border: 4px solid #e0e0e0;
    border-top-width: 0;
    border-radius: 0 0 30px 30px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-direction: column-reverse; 
    justify-content: flex-start; 
    align-items: center;
    padding-bottom: 8px;
    box-sizing: border-box;
    overflow: visible; /* ড্র্যাগ করার সময় বল বাইরে দেখা যাবে */
}

.ball {
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    margin-top: 4px;
    /* transition সরানো হয়েছে যাতে ড্র্যাগ করার সময় ল্যাগ না করে */
}

/* ড্র্যাগিং অবস্থার জন্য */
.ball-dragging {
    scale: 1.15;
    opacity: 0.9;
    border-width: 2px;
    border-color: white;
}

@keyframes tube-pulse {
    0% { scale: 1; }
    50% { scale: 1.1; border-color: #f9d923; border-width: 6px;}
    100% { scale: 1; }
}

.tube-complete {
    animation-name: tube-pulse;
    animation-duration: 0.4s;
    animation-iteration-count: 2;
}

/* উইন স্ক্রিনের ওভারলে */
.win-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.5s;
    visibility: hidden;
}

.win-overlay-active {
    opacity: 1;
    visibility: visible;
}

.win-text {
    color: #f9d923;
    font-size: 70px;
    -unity-font-style: bold;
    text-shadow: 4px 4px 8px #000000;
}

.color-green { background-color: #4e9f3d; }
.color-cyan { background-color: #00d2ff; }
.color-yellow { background-color: #f9d923; }
.color-pink { background-color: #ff9a9e; }
.color-orange { background-color: #ff7b54; }
.color-blue { background-color: #533483; }